{
  "name": "tack-issue-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "dev": "node scripts/with-env.mjs next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/with-env.mjs vitest run",
    "test:watch": "node scripts/with-env.mjs vitest",
    "test:e2e": "node scripts/with-env.mjs playwright test",
    "test:e2e:prepare": "node --import tsx scripts/e2e-prepare.ts",
    "db:migrate": "node scripts/with-env.mjs node --import tsx scripts/migrate.ts",
    "db:seed": "node scripts/with-env.mjs node --import tsx scripts/seed.ts",
    "db:bootstrap": "node scripts/with-env.mjs node --import tsx scripts/bootstrap-admin.ts",
    "db:backup": "./scripts/backup.sh",
    "db:restore": "./scripts/restore.sh",
    "mcp": "node --import tsx tools/tack-mcp.ts",
    "docs:build": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:preview": "node scripts/serve-docs.mjs",
    "docs:verify": "node scripts/verify-docs.mjs"
  },
  "dependencies": {
    "@better-auth/api-key": "1.6.25",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@modelcontextprotocol/sdk": "1.32.0",
    "better-auth": "^1.6.25",
    "lucide-react": "1.27.0",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.2",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "remark-gfm": "4.0.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.9.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/p2dev/tack.git"
  }
}
