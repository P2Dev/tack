# Copy to .env before running `docker compose up --build`.
POSTGRES_DB=tack
POSTGRES_USER=tack
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=54329

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Bind locally by default. Use a reverse proxy for LAN/public HTTPS.
TACK_BIND_ADDRESS=127.0.0.1
TACK_PORT=3000
TACK_ADMIN_EMAIL=admin@example.com
TACK_ADMIN_PASSWORD=replace-with-a-strong-temporary-password
TACK_ADMIN_NAME=Tack Admin
TACK_ADMIN_COLOR=rust

# Local email/password always remains available. Choose local or a configured ID.
TACK_AUTH_DEFAULT=local
# Optional Cognito User Pool issuer (copy its exact issuer, not its hosted login domain).
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_NAME=Amazon Cognito
# false: provision a matching local account first. true: verified pool users join as members.
COGNITO_ALLOW_SIGN_UP=false
# Optional additional OIDC providers; JSON array. Keep client secrets server-side.
TACK_OIDC_PROVIDERS=[]
